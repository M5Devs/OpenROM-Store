---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';

interface NavbarUser {
  githubUsername: string;
  name: string | null;
  avatarUrl: string | null;
}

interface Props {
  user?: NavbarUser | null;
}

const { user = null } = Astro.props;

// The navbar is shared by every route, so the search box pre-fills from the
// current ?q= and submits back to the catalog. That keeps search working from
// pages that have no catalog of their own (a plugin or publisher page).
const searchValue = Astro.url.searchParams.get('q') ?? '';
---

<header class="sticky top-0 z-40 border-b border-zinc-900/80 bg-zinc-950/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img
        src="/images/romeo/romeo-idle.gif"
        alt="OpenROM"
        width="36"
        height="36"
        class="w-9 h-9 rounded-lg"
      />
      <span class="hidden flex-col leading-none sm:flex">
        <span class="text-sm font-semibold tracking-tight text-zinc-100">OpenROM</span>
        <span class="text-[0.7rem] font-medium tracking-wide text-zinc-500">MARKETPLACE</span>
      </span>
    </a>

    <form
      role="search"
      method="get"
      action="/"
      class="relative flex-1"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6" />
        <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input
        id="search"
        name="q"
        type="search"
        autocomplete="off"
        value={searchValue || undefined}
        placeholder="Search extensions, publishers, routes…"
        aria-label="Search extensions"
        class="h-10 w-full rounded-lg border border-zinc-800 bg-zinc-900/60 pl-9 pr-10 text-sm text-zinc-100 placeholder:text-zinc-500 focus:border-cyan-500/50 focus:outline-none focus:ring-2 focus:ring-cyan-500/20"
      />
      <button
        type="button"
        data-search-clear
        aria-label="Clear search"
        class:list={[
          'absolute right-2 top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-md text-zinc-500 transition hover:bg-zinc-800 hover:text-zinc-200',
          { hidden: !searchValue },
        ]}
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </form>

    <nav class="flex shrink-0 items-center gap-2">
      <a
        href={SITE.github}
        class="hidden h-10 items-center gap-2 rounded-lg border border-zinc-800 px-3 text-sm text-zinc-300 transition hover:border-zinc-700 hover:text-white sm:inline-flex"
      >
        GitHub
      </a>
      <a
        href={SITE.discord}
        class="hidden h-10 items-center gap-2 rounded-lg border border-zinc-800 px-3 text-sm text-zinc-300 transition hover:border-zinc-700 hover:text-white sm:inline-flex"
      >
        Discord
      </a>
      <a
        href={SITE.publish}
        class="hidden h-10 items-center gap-2 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-4 text-sm font-medium text-zinc-950 transition hover:from-cyan-400 hover:to-purple-400 sm:inline-flex"
      >
        Publish an Extension
      </a>

      {
        user ? (
          <div class="flex items-center gap-2">
            <div data-inbox class="relative">
              <button
                type="button"
                data-inbox-trigger
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label="Notifications"
                class="relative grid h-10 w-10 place-items-center rounded-lg border border-zinc-800 text-zinc-300 transition hover:border-zinc-700 hover:text-white"
              >
                <Icon name="bell" class="h-5 w-5" />
                <span
                  data-inbox-badge
                  class="absolute -right-1 -top-1 hidden min-w-[1.1rem] rounded-full bg-red-500 px-1 text-center text-[0.65rem] font-semibold leading-[1.1rem] text-white"
                >
                  0
                </span>
              </button>

              <div
                data-inbox-panel
                role="dialog"
                aria-label="Notifications"
                class="absolute right-0 z-50 mt-2 hidden w-80 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/95 shadow-2xl backdrop-blur-xl sm:w-96"
              >
                <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                  <p class="text-sm font-semibold text-zinc-100">Notifications</p>
                  <button
                    type="button"
                    data-inbox-read-all
                    class="text-xs font-medium text-cyan-300 transition hover:text-cyan-200"
                  >
                    Mark all as read
                  </button>
                </div>
                <div data-inbox-list class="max-h-96 overflow-y-auto">
                  <p class="px-4 py-6 text-center text-sm text-zinc-500">Loading…</p>
                </div>
              </div>
            </div>

            <div data-user-menu class="relative">
            <button
              type="button"
              data-user-menu-trigger
              aria-haspopup="menu"
              aria-expanded="false"
              class="flex h-10 items-center gap-2 rounded-lg border border-zinc-800 pl-1 pr-2.5 transition hover:border-zinc-700"
            >
              {user.avatarUrl ? (
                <img
                  src={user.avatarUrl}
                  alt=""
                  width="32"
                  height="32"
                  referrerpolicy="no-referrer"
                  class="h-8 w-8 rounded-md ring-1 ring-inset ring-zinc-700"
                />
              ) : (
                <span class="grid h-8 w-8 place-items-center rounded-md bg-zinc-800 text-xs font-semibold text-zinc-300">
                  {user.githubUsername.slice(0, 1).toUpperCase()}
                </span>
              )}
              <span class="hidden max-w-[9rem] truncate text-sm text-zinc-200 sm:inline">
                {user.githubUsername}
              </span>
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-zinc-500" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <div
              data-user-menu-panel
              role="menu"
              class="absolute right-0 z-50 mt-2 hidden w-56 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/95 shadow-2xl backdrop-blur-xl"
            >
              <div class="border-b border-zinc-800 px-4 py-3">
                <p class="truncate text-sm font-medium text-zinc-100">
                  {user.name ?? user.githubUsername}
                </p>
                <p class="truncate text-xs text-zinc-500">@{user.githubUsername}</p>
              </div>
              <div class="p-1">
                <a
                  href="/dashboard"
                  role="menuitem"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-zinc-300 transition hover:bg-zinc-900 hover:text-white"
                >
                  My Publishers / Dashboard
                </a>
                <a
                  href="/dashboard/settings"
                  role="menuitem"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-zinc-300 transition hover:bg-zinc-900 hover:text-white"
                >
                  Account settings
                </a>
                <form method="POST" action="/api/auth/logout">
                  <button
                    type="submit"
                    role="menuitem"
                    class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-zinc-300 transition hover:bg-zinc-900 hover:text-white"
                  >
                    Sign Out
                  </button>
                </form>
              </div>
            </div>
            </div>
          </div>
        ) : (
          <a
            href="/api/auth/login"
            class="inline-flex h-10 items-center gap-2 rounded-lg border border-zinc-800 px-4 text-sm font-medium text-zinc-200 transition hover:border-zinc-700 hover:text-white"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
            </svg>
            Sign in with GitHub
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-user-menu]');
  const trigger = menu?.querySelector<HTMLElement>('[data-user-menu-trigger]');
  const panel = menu?.querySelector<HTMLElement>('[data-user-menu-panel]');

  function closeMenu() {
    panel?.classList.add('hidden');
    trigger?.setAttribute('aria-expanded', 'false');
  }

  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = panel?.classList.toggle('hidden') === false;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.addEventListener('click', (event) => {
    if (!menu?.contains(event.target as Node)) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  // --- Search box ---
  const searchInput = document.querySelector<HTMLInputElement>('#search');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-search-clear]');

  function syncClearButton() {
    if (!searchInput || !clearButton) return;
    clearButton.classList.toggle('hidden', searchInput.value.length === 0);
  }

  searchInput?.addEventListener('input', syncClearButton);

  clearButton?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    syncClearButton();
    // A ?q= search is answered server-side, so the grid only holds the matching
    // subset and restoring everything needs a fresh request. Without one the full
    // catalog is already in the DOM, so let the page's own filter reset it in place.
    if (new URLSearchParams(location.search).has('q')) {
      location.href = '/';
    } else {
      searchInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
  });

  syncClearButton();

  // --- Notification inbox ---
  interface InboxNotification {
    id: number;
    type: string;
    title: string;
    message: string;
    actionUrl: string | null;
    data: { publisher_id?: string; role?: string } | null;
    isRead: boolean;
    createdAt: string;
  }

  const inbox = document.querySelector<HTMLElement>('[data-inbox]');
  const inboxTrigger = inbox?.querySelector<HTMLElement>('[data-inbox-trigger]');
  const inboxPanel = inbox?.querySelector<HTMLElement>('[data-inbox-panel]');
  const inboxList = inbox?.querySelector<HTMLElement>('[data-inbox-list]');
  const inboxBadge = inbox?.querySelector<HTMLElement>('[data-inbox-badge]');
  const readAllButton = inbox?.querySelector<HTMLElement>('[data-inbox-read-all]');

  function setBadge(count: number) {
    if (!inboxBadge) return;
    inboxBadge.textContent = count > 99 ? '99+' : String(count);
    inboxBadge.classList.toggle('hidden', count <= 0);
  }

  /** Escape untrusted notification text before it goes into innerHTML. */
  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (char) => {
      switch (char) {
        case '&': return '&amp;';
        case '<': return '&lt;';
        case '>': return '&gt;';
        case '"': return '&quot;';
        default: return '&#39;';
      }
    });
  }

  function iconFor(type: string): string {
    if (type === 'team_invite') return '📨';
    if (type === 'plugin_approved') return '✅';
    if (type === 'admin_alert') return '⚠️';
    return '🔔';
  }

  function renderNotification(item: InboxNotification): string {
    const isInvite = item.type === 'team_invite' && item.data?.publisher_id;
    const actions = isInvite
      ? `<div class="mt-2 flex gap-2">
           <button type="button" data-invite-action="accept" data-publisher="${escapeHtml(item.data!.publisher_id!)}"
             class="inline-flex h-8 items-center gap-1 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-3 text-xs font-semibold text-cyan-300 transition hover:bg-cyan-500/20">
             Accept ✅
           </button>
           <button type="button" data-invite-action="decline" data-publisher="${escapeHtml(item.data!.publisher_id!)}"
             class="inline-flex h-8 items-center gap-1 rounded-lg border border-zinc-700 px-3 text-xs font-medium text-zinc-300 transition hover:bg-zinc-800">
             Decline ❌
           </button>
         </div>`
      : '';
    const link = item.actionUrl
      ? `<a href="${escapeHtml(item.actionUrl)}" class="mt-1 inline-block text-xs text-cyan-300 transition hover:text-cyan-200">View →</a>`
      : '';
    return `<div class="border-b border-zinc-900 px-4 py-3 ${item.isRead ? '' : 'bg-cyan-500/5'}">
      <div class="flex items-start gap-2">
        <span aria-hidden="true">${iconFor(item.type)}</span>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-zinc-100">${escapeHtml(item.title)}</p>
          <p class="mt-0.5 text-xs leading-relaxed text-zinc-400">${escapeHtml(item.message)}</p>
          ${actions}
          ${link}
        </div>
      </div>
    </div>`;
  }

  async function loadInbox() {
    if (!inboxList) return;
    try {
      const response = await fetch('/api/notifications', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('failed');
      const data = (await response.json()) as { notifications: InboxNotification[]; unread: number };
      setBadge(data.unread);
      inboxList.innerHTML =
        data.notifications.length === 0
          ? '<p class="px-4 py-6 text-center text-sm text-zinc-500">You have no notifications yet.</p>'
          : data.notifications.map(renderNotification).join('');
    } catch {
      inboxList.innerHTML =
        '<p class="px-4 py-6 text-center text-sm text-zinc-500">Could not load your inbox.</p>';
    }
  }

  function closeInbox() {
    inboxPanel?.classList.add('hidden');
    inboxTrigger?.setAttribute('aria-expanded', 'false');
  }

  inboxTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = inboxPanel?.classList.toggle('hidden') === false;
    inboxTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) void loadInbox();
  });

  readAllButton?.addEventListener('click', async (event) => {
    event.stopPropagation();
    try {
      const response = await fetch('/api/notifications/read-all', { method: 'POST' });
      if (response.ok) {
        setBadge(0);
        void loadInbox();
      }
    } catch {
      /* Leave the badge as-is; the next open retries. */
    }
  });

  // Accept/Decline act on an invitation without leaving the page.
  inboxList?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-invite-action]');
    if (!button) return;
    const action = button.dataset.inviteAction;
    const publisherId = button.dataset.publisher ?? '';
    button.setAttribute('disabled', 'true');
    try {
      const response = await fetch(
        `/api/publishers/${encodeURIComponent(publisherId)}/team/respond`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        },
      );
      if (response.ok) {
        // The badge changed (the invite was marked read), so refresh the list.
        void loadInbox();
      } else {
        button.removeAttribute('disabled');
      }
    } catch {
      button.removeAttribute('disabled');
    }
  });

  document.addEventListener('click', (event) => {
    if (!inbox?.contains(event.target as Node)) closeInbox();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeInbox();
  });

  // Paint the unread badge on load, without opening the panel.
  if (inbox) {
    void fetch('/api/notifications', { headers: { Accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { unread: number } | null) => {
        if (data) setBadge(data.unread);
      })
      .catch(() => {
        /* A failed badge fetch must not disturb the page. */
      });
  }
</script>
