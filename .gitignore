__pycache__/

# Plugin binaries are never committed to this metadata-only repository.
# Packaged extensions are hosted on SourceForge.
*.orplug
# Packaged skins (.orskin) are published to SourceForge, never committed here.
*.orskin
# Theme preview screenshots are hosted on SourceForge next to the bundle, never
# committed here (image binaries would bloat the metadata-only repo).
public/images/previews/
# SourceForge upload probe artifacts
sf_probe_healthcheck.txt
temp_healthcheck.txt

# Local tooling / build artifacts
node_modules/
.wrangler/
.dev.vars
.env
.env.*
.openhands/

# Astro build output
dist/
.astro/

# Local .orskin authoring staging (packages are published to SourceForge, not committed)
stage_skin/
stage_skin_v2/
